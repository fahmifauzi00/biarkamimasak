# OpenRouter API Configuration
# Get your API key for free from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: Override the model (defaults to deepseek/deepseek-v4-flash-0731)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Optional: Override the base URL (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Biar Kami Masak API Authentication Key
RECIPE_API_KEY=your_recipe_api_key
